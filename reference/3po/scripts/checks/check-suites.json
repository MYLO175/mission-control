{
  "schemaVersion": 1,
  "tiers": {
    "source-free": {
      "automatic": true,
      "description": "All audited component checks; fictional values, in-memory or private temporary storage, offline helper fixtures. No app launch, personal source reads, native writes, model requests or downloads."
    },
    "app-memory": {
      "automatic": false,
      "description": "Integration-owner checks in a signed DEBUG candidate before normal source startup; disposable app storage. Requires --candidate-binary with a signed DEBUG protocol handshake; runs only the listed exact modes and verifies a fresh complete report with zero model requests."
    },
    "native": {
      "automatic": false,
      "description": "Integration-owner disposable UUID Calendar/Reminder fixtures under existing permissions; creates, edits, completes, undoes and removes test records. Explicitly separate from source-free checks. Requires --candidate-binary with a signed DEBUG protocol handshake; runs only the listed exact modes."
    },
    "model": {
      "automatic": false,
      "description": "Integration-owner configured subscription model checks on fictional inputs; consumes requests and needs the current account. Narrow quality checks, separate from deterministic coverage. Requires --candidate-binary with a signed DEBUG protocol handshake; runs only the listed exact modes."
    },
    "performance": {
      "automatic": true,
      "description": "Optional source-free measurements on fictional storage/memory/history sizes. Successful completion reports timings only; it does not assert an agreed performance target or UI speedup. MISSIONCONTROL_PERFORMANCE_MODE=debug (default) or release labels the compile mode."
    }
  },
